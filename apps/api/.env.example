NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=novaops

JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=14d

CORS_ORIGIN=http://localhost:5173

# 仪表盘无真实上游时使用 mock（无真实计量源时即使 false 也会回落 mock）
DASHBOARD_USE_MOCK=true

# 生产关闭 synchronize 后，可用：
# mysql -u <user> -p novaops < apps/api/migrations/001_init_schema.sql
